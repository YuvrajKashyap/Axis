generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String        @id @default(cuid())
  email       String        @unique
  password    String
  name        String?
  domains     Domain[]
  commitments Commitment[]
  subtasks    DomainSubtask[]
  subtaskCompletions DomainSubtaskCompletion[]
  settings    UserSettings?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Domain {
  id          String         @id @default(cuid())
  userId      String
  name        String
  slug        String
  description String?
  identity    String?
  primaryReason String?
  primaryCost String?
  nextMove    String?
  vision         String?
  currentReality String?
  standard       String?
  proof          String?
  color          String?
  status      DomainStatus   @default(NEUTRAL)
  driftMode   DomainDriftMode @default(PRESET)
  driftThresholdHours Int     @default(72)
  commitmentRequirement DomainCommitmentRequirement @default(STANDARD)
  subtaskResetMode DomainSubtaskResetMode @default(DAILY)
  subtaskTimeZone String @default("UTC")
  orbitSpeed DomainOrbitSpeed @default(STANDARD)
  visualIntensity DomainVisualIntensity @default(BALANCED)
  planetSizeScale Float @default(1)
  orbitEccentricity DomainOrbitEccentricity @default(DEFAULT)
  lastPassiveAlignmentAt DateTime?
  lastDriftWarningSentAt DateTime?
  lastDriftWarningActivityAt DateTime?

  positionX   Float          @default(0)
  positionY   Float          @default(0)
  positionZ   Float          @default(0)

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  commitments Commitment[]
  subtasks    DomainSubtask[]
  subtaskCompletions DomainSubtaskCompletion[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, slug])
}

model Commitment {
  id          String             @id @default(cuid())
  userId      String
  domainId    String
  text        String
  completed   Boolean            @default(false)

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain      Domain             @relation(fields: [domainId], references: [id], onDelete: Cascade)

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model DomainSubtask {
  id          String                    @id @default(cuid())
  userId      String
  domainId    String
  label       String
  sortOrder   Int                       @default(0)

  user        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain      Domain                    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  completions DomainSubtaskCompletion[]

  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([userId, domainId, sortOrder])
}

model DomainSubtaskCompletion {
  id          String        @id @default(cuid())
  userId      String
  domainId    String
  subtaskId   String
  periodKey   String
  completedAt DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain      Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  subtask     DomainSubtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now())

  @@unique([subtaskId, periodKey])
  @@index([userId, domainId, periodKey])
}

model UserSettings {
  id          String      @id @default(cuid())
  userId      String      @unique
  theme       String      @default("dark")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum DomainStatus {
  ALIGNED
  NEUTRAL
  DRIFTING
  ARCHIVED
}

enum DomainDriftMode {
  PRESET
  CUSTOM
  NEVER
}

enum DomainCommitmentRequirement {
  STANDARD
  PASSIVE_ALIGNMENT
  SUBTASKS
}

enum DomainSubtaskResetMode {
  DAILY
  DRIFT_CYCLE
}

enum DomainOrbitSpeed {
  STILL
  SLOW
  STANDARD
  FAST
}

enum DomainVisualIntensity {
  SUBTLE
  BALANCED
  INTENSE
}

enum DomainOrbitEccentricity {
  DEFAULT
  SLIGHTLY_ELLIPTICAL
  VERY_ELLIPTICAL
}
